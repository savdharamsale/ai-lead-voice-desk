# ========================================================
# AI Lead & Voice Desk - Configuration Variables
# ========================================================
APP_ENV=development
SECRET_KEY=replace_with_32_bytes_random_hex_string
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Database & Storage
DATABASE_URL=postgresql://desk_user:desk_password@localhost:5432/desk_db
REDIS_URL=redis://localhost:6379/0

# Sarvam AI Voice
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# Telephony Configuration (Default: mock for local testing)
DEFAULT_TELEPHONY_PROVIDER=mock # Options: mock, sarvam_vobiz, exotel, smartflo

# Vobiz Credentials (if BYO Vobiz)
VOBIZ_ACCOUNT_ID=
VOBIZ_AUTH_TOKEN=

# Exotel Credentials (if using Exotel)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=

# Tata Tele Smartflo Credentials (if using Smartflo)
SMARTFLO_API_KEY=
SMARTFLO_API_SECRET=

# Regulatory Compliance (TRAI India)
ENFORCE_CALLING_HOURS=true
CALLING_WINDOW_START_HOUR=9
CALLING_WINDOW_END_HOUR=21
